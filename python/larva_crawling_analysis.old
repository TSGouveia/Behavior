   "execution_count": 136
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Cumulative distance traveled\n",
    "\n",
    "A quick check on overall activity level and whether the larva kept crawling steadily or\n",
    "mostly stopped early.\n"
   ],
   "id": "202fcabc3cc18201"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-09-10T23:14:09.867683Z",
     "start_time": "2026-09-10T23:14:09.765762Z"
    }
   },
   "source": [
    "cum_dist = df[\"step_dist_mm\"].fillna(0).cumsum()\n",
    "t = df[\"Frame\"] / df[\"fps\"].iloc[0]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "ax.plot(t, cum_dist)\n",
    "ax.set_xlabel(\"Time (s)\")\n",
    "ax.set_ylabel(\"Cumulative distance (mm)\")\n",
    "ax.set_title(f\"Cumulative distance — {Path(CSV_PATH).stem}\")\n",
    "plt.show()\n"
   ],
   "id": "252f67c5395a32c2",
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<Figure size 800x400 with 1 Axes>"
      ],
      "image/png": ""
     },
     "metadata": {},
     "output_type": "display_data",
     "jetTransient": {
      "display_id": null
     }
    }
   ],
   "execution_count": 137
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Batch analysis (many videos / larvae at once)\n",
    "\n",
    "Point this at a folder containing all your Fiji-macro output CSVs (one per video/larva).\n",
    "Each file is run through the same cleaning + kinematics pipeline, then combined into one\n",
    "summary table with automatic QC flags — videos whose numbers stand out from the rest of the\n",
    "batch (not from a fixed universal cutoff, since \"normal\" varies by genotype/condition/setup)\n",
    "get flagged for a quick visual double-check.\n"
   ],
   "id": "820436ae5d7e6793"
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-09-10T23:14:09.881282Z",
     "start_time": "2026-09-10T23:14:09.874754Z"
    }
   },
   "source": [
    "# ---- EDIT THIS CELL for your data ----\n",
    "\n",
    "# Automatically determine the directory containing coordinate CSVs\n",
    "candidate_csv_folders = [Path('../data/csvs'), Path('data/csvs'), Path('behavior/data/csvs'), Path('.')]\n",
    "CSV_FOLDER = '.'\n",
    "for cand in candidate_csv_folders:\n",
    "    if cand.exists() and any(cand.glob('*.csv')):\n",
    "        CSV_FOLDER = str(cand)\n",
    "        break\n",
    "\n",
    "CSV_PATTERN = '*.csv'     # glob pattern to select them; narrow this if the folder has other CSVs\n",
    "\n",
    "csv_paths = [\n",
    "    p for p in sorted(Path(CSV_FOLDER).glob(CSV_PATTERN))\n",
    "    if not p.name.startswith('larva_batch_summary')\n",
    "]\n",
    "print(f'Using CSV_FOLDER: {CSV_FOLDER}')\n",
    "print(f'Found {len(csv_paths)} CSV files:')\n",
    "for p in csv_paths:\n",
    "    print(' -', p.name)\n"
   ],
   "id": "d86d03c109f2ae93",
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Using CSV_FOLDER: ..\\data\\csvs\n",
      "Found 9 CSV files:\n",
      " - N2_nSybxRalRNAi_L1_FA.csv\n",
      " - N2_nSybxRalRNAi_L2_FA.csv\n",
      " - N2_nSybxRalRNAi_L3_FA.csv\n",
      " - N2_nSybxRalRNAi_L4_FA.csv\n",
      " - N2_nSybxRalRNAi_L5_FA.csv\n",
      " - N2_nSybxRalRNAi_L6_FA.csv\n",
      " - N2_nSybxRalRNAi_L7_FA.csv\n",
      " - N2_nSybxRalRNAi_L8_FA.csv\n",
      " - N2_nSybxRalRNAi_L9_FA.csv\n"
     ]
    }
   ],
   "execution_count": 138
  },
  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-09-10T23:14:11.256541Z",
     "start_time": "2026-09-10T23:14:09.898317Z"
    }
   },
   "source": [
    "summary_table = batch_summarize(\n",
    "    csv_paths,\n",
    "    fps=FPS,\n",
    "    max_gap_frames=MAX_GAP_FRAMES,\n",
    "    max_speed_mm_s=MAX_SPEED_MM_S,\n",
    ")\n",
    "summary_table\n"
   ],
   "id": "41e0614b2d7989cc",
