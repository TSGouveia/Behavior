  {
   "cell_type": "code",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-09-10T23:14:09.722993Z",
     "start_time": "2026-09-10T23:14:09.614616Z"
    }
   },
   "source": [
    "fig, ax = plt.subplots(figsize=(8, 4))\n",
    "epoch_time_s = epoch_stats[\"epoch\"] * EPOCH_S\n",
    "ax.plot(epoch_time_s, epoch_stats[\"max\"], label=\"max\", marker=\"o\")\n",
    "ax.plot(epoch_time_s, epoch_stats[\"mean\"], label=\"mean\", marker=\"o\")\n",
    "ax.plot(epoch_time_s, epoch_stats[\"median\"], label=\"median\", marker=\"o\")\n",
    "ax.set_xlabel(\"Time (s)\")\n",
    "ax.set_ylabel(\"Speed (mm/s)\")\n",
    "ax.set_title(f\"Speed per {EPOCH_S}s epoch — {Path(CSV_PATH).stem}\")\n",
    "ax.legend()\n",
    "plt.show()\n"
   ],
   "id": "ef6f9a097501a7e7",
   "outputs": [
    {
     "data": {
      "text/plain": [
       "<Figure size 800x400 with 1 Axes>"
